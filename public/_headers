# DIGIT. assets use fixed filenames, so keep their cache lifetime short.
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate
/digit-favicon.svg
  Cache-Control: public, max-age=86400, must-revalidate
/digit-ogp.png
  Cache-Control: public, max-age=86400, must-revalidate
/digit-network-hero.svg
  Cache-Control: public, max-age=86400, must-revalidate
/digit-robot.svg
  Cache-Control: public, max-age=86400, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/articles/*
  Cache-Control: public, max-age=0, must-revalidate
