{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "were-kyoto-site",
  "compatibility_date": "2026-08-28",
  "main": "./worker/index.mjs",
  "routes": [
    {
      "pattern": "were-kyoto.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/website",
      "/website/",
      "/reservation",
      "/reservation/",
      "/case/sophie-kyoto",
      "/case/sophie-kyoto/",
      "/contact",
      "/contact/",
      "/thanks",
      "/thanks/"
    ]
  }
}
