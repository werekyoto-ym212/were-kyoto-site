{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "were-kyoto-site",
  "compatibility_date": "2026-08-28",
  "main": "./worker/index.mjs",
  "routes": [
    {
      "pattern": "were-kyoto.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
